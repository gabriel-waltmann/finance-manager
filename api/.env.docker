# Development-only settings used by the API service in docker-compose.yml.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5266
DOTNET_USE_POLLING_FILE_WATCHER=1

Database__Host=db
Database__Port=5432
Database__Name=finance-manager-db
Database__User=finance-manager-user
Database__Password=finance-manager-password-123

Redis__Host=redis
Redis__Port=6379

RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__UserName=admin
RabbitMq__Password=finance-manager-rabbitmq-password-123
RabbitMq__TransactionImportQueueName=jobs.transaction-import
